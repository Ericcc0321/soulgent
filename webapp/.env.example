# Soulgent web app config sample: copy to .env and fill it in (.env is gitignored; secrets go only there)

# ---- Required ----
# Admin login key, at least 24 characters (e.g. generate with openssl rand -hex 24)
WEBAPP_KEY=
# The Mac's .local name (put into the certificate; the phone can also use it to reach the site)
SITE_HOST=your-mac.local
# The Mac's LAN IP: Caddy listens only on this address, port 8443. If the IP changes, edit it here and run docker compose up -d
SITE_IP=192.168.1.10
# Signing key for the request/result files exchanged between the api and the helper, at least 32 characters
# (generate: python3 -c 'import secrets;print(secrets.token_hex(32))').
# The api reads it from here (container env_file) and the helper reads this same file; both sides must match. If unset, the api
# rejects write requests (sending returns 500) and the helper executes nothing.
# After changing it, run docker compose up -d api and restart the helper (bash helper/install.sh)
OUTBOX_SECRET=

# ---- Deployment name (optional) ----
# docker compose project name; it decides container and volume names (<name>_state holds subscriptions, profiles, pins, etc.).
# Defaults to soulgent
COMPOSE_PROJECT_NAME=

# ---- Push notifications (optional; generate with tools/gen_vapid.py, which appends the keys here) ----
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact address for the push service, e.g. mailto:you@example.com. Leave empty here and pass it when generating keys:
#   VAPID_SUBJECT=mailto:you@example.com python3 tools/gen_vapid.py .env
# (gen_vapid.py fills empty entries only; without VAPID_SUBJECT it writes the placeholder mailto:admin@example.com)
VAPID_SUBJECT=

# ---- Guest account (optional; disabled when GUEST_KEY is empty) ----
# A guest sees only the one session bound below, can chat in it and recall their own messages; questions and approvals are handled by the admin
# Guest login key, at least 24 characters, must differ from WEBAPP_KEY
GUEST_KEY=
# Full name of the session the guest can see (if the session is renamed, update this and run docker compose up -d)
GUEST_SESSION=
# Default guest nickname (shown while the guest has not set one; also used in the admin profile page notes). Defaults to the localized "Guest" label
GUEST_NAME=
# Prefix the server prepends to every guest message (no spaces; one space always follows it); the agent in the session uses it to recognize the guest.
# The text on the avatar tile is taken from it too (brackets removed). Defaults to [Guest]
GUEST_TAG=
# How much of the session roster goes into the guest snapshot (group-chat avatars, badges and lead stars use it to recognize other sessions):
#   bound (default; also used when unset or invalid): only the guest's own bound session, so the names of the admin's other sessions are not visible;
#          when a group chat contains a session outside the roster, its avatar shows a zone-colored initial derived from the name, without pet or lead star
#   all: the whole roster (on-duty and off-duty session names, zones, lead flags), excluding only sessions bound to other guests
# GUEST_ROSTER=bound
# Slash commands a guest may send, comma-separated (e.g. /window; /window is a custom window-handoff command, not built into Claude Code).
# Empty (default) = guests cannot send any slash command
GUEST_SLASH_COMMANDS=

# ---- More guests (optional; there is no second guest when GUEST2_KEY is empty) ----
# The GUEST_* keys above describe the first guest (internal account name guest). The second guest onward use numbered keys GUEST2_* ... GUEST9_*.
# Each guest has their own key, bound session, prefix and nickname; guests cannot see each other's sessions, messages, avatars, pushes or devices
# Guest id: 1-16 lowercase letters or digits, used as the internal account name and the state volume file name (profile-<id>.json); cannot be guest / admin
GUEST2_ID=
# Login key, at least 24 characters, must differ from WEBAPP_KEY and from other guests' keys. Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
GUEST2_KEY=
# Full name of the session this guest can see
GUEST2_SESSION=
# Prefix; must differ from other guests' prefixes (it identifies who spoke). Defaults to [ID in uppercase]
GUEST2_TAG=
# Default nickname; defaults to the localized "Guest" label
GUEST2_NAME=

# ---- Private reverse proxy (optional) ----
# Admin-only path prefixes, comma-separated (e.g. /docs,/tools): guests always get 403. The proxy itself is defined in caddy-private/*.caddy
# (see caddy-private/proxy.caddy.example); variables it needs, such as secrets, are passed to caddy in docker-compose.override.yml
ADMIN_ONLY_PREFIXES=

# ---- Bubble attachments (optional) ----
# Extra host directories the phone may open: "host path=container path" pairs separated by colons; they must match the mounts in docker-compose.override.yml
# (see docker-compose.override.yml.example; if the override sets FILE_ROOTS, the override wins)
FILE_ROOTS=

# ---- Helper (optional) ----
# Path of Soulgent for Mac (Soulgent.app). If unset, Soulgent.app is looked up in ../app, /Applications and ~/Applications, in that order
SOULGENT_PANEL=
# Private file with zone display styles (short badge name for cross-team badges, avatar effect while working). Defaults to data/zone-style.json, which may be absent.
# Format: {"zone-code": {"short": "short name", "fx": "marquee|circuit|halo|orbit"}}; the same fields can also go directly in the zone entries of workzones.json
SOULGENT_ZONE_STYLE=
# Optional extension: path of a script that wakes or retires off-duty sessions (you provide it; it is called with --wake or --off plus the session name).
# If unset, wake and send-off are unavailable. Restart the helper after changing it
SOULGENT_OFFDUTY=

# ---- External locations the helper reads (optional; the defaults below apply when unset. Each is read once at helper start; restart the helper after changing: bash helper/install.sh) ----
# What happens when each item is missing: see docs/dependencies.md. Paths may start with ~/; do not put a # comment after a value
# Claude Code config directory (sessions/ registry and projects/ transcripts below). Defaults to ~/.claude;
# change it only if you moved it with CLAUDE_CONFIG_DIR, and also change the api's /projects mount in docker-compose.override.yml.
# When set elsewhere, the helper also passes it as CLAUDE_CONFIG_DIR to the child process that runs the context breakdown (claude -p /context)
SOULGENT_CLAUDE_DIR=
# Zone table. Defaults to <Claude dir>/workzones.json. Without this file every session is unzoned
SOULGENT_WORKZONES=
# Optional extension: off-duty roster (JSON: {session name: {...}}, maintained by your off-duty script). If unset, no off-duty list is shown
SOULGENT_ROSTER=
# Optional extension: window lineage (jsonl; your window-switch script appends one line per switch). If unset, only the current window is shown
SOULGENT_LINEAGE=
# Directory where the statusline script writes meta.<session id>.json (model / context / t/s on the chat page). Defaults to /tmp/claude-statusline
SOULGENT_STATUSLINE_DIR=
# The orca command. If unset, /usr/local/bin/orca and /Applications/Orca.app/Contents/Resources/bin/orca are tried in order. Set it if Orca is installed elsewhere
SOULGENT_ORCA_BIN=
# Orca data directory (orca-stats.json, orca-claude-usage.json). Defaults to ~/Library/Application Support/orca
SOULGENT_ORCA_STATS_DIR=
# The claude command (used for the context breakdown). If unset, ~/.local/bin, /opt/homebrew/bin, /usr/local/bin and PATH are searched. Set it if installed elsewhere
SOULGENT_CLAUDE_BIN=
# Petdex pets directory (the second source for tools/build_pets.py; the first is ../app/pets). Defaults to ~/.petdex/pets
SOULGENT_PETDEX_DIR=
# UserDefaults domain of Soulgent for Mac (pets, seen, pins). Defaults to io.github.ericcc0321.soulgent. Change it only if the app uses a different Bundle ID
SOULGENT_PANEL_DOMAIN=
# launchd label of the helper (used by helper/install.sh and uninstall.sh). Defaults to io.github.ericcc0321.soulgent.helper
SOULGENT_HELPER_LABEL=
