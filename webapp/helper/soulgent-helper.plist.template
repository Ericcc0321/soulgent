<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__WEBAPP__/helper/snapshot.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__WEBAPP__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUTF8</key>
        <string>1</string>
__ENV_EXTRA__
    </dict>
    <!-- Without ProcessType launchd throttles the helper (each orca call ~0.2 s slower); Background is worse (dump times out) -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__WEBAPP__/data/helper.log</string>
    <key>StandardErrorPath</key>
    <string>__WEBAPP__/data/helper.log</string>
</dict>
</plist>
